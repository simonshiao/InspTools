  <ItemGroup>
    <!--
      Preserve the original WPF pack-resource layout. The exported individual
      BAML/image files are useful for inspection, but the rebuilt assembly
      embeds the original InspTools.g.resources container so that
      Application.LoadComponent pack URIs resolve exactly as in the vendor DLL.
    -->
    <EmbeddedResource Remove="**\*.baml" />
    <EmbeddedResource Remove="res\*.png" />
    <EmbeddedResource Remove="res\*.bmp" />
    <EmbeddedResource Include="InspTools.g.resources" LogicalName="InspTools.g.resources">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
